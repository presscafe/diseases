{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/presscafe/diseases/data/schema.json",
  "title": "Disease record",
  "description": "One disease, organised around the four pillars: agents, aetiology, pathophysiology, control and management. The authoritative validator is tools/validate.mjs; this schema exists for editor autocomplete and for human readers.",
  "type": "object",
  "required": [
    "slug",
    "name",
    "category",
    "agents",
    "hosts",
    "zoonotic",
    "notifiable",
    "aetiology",
    "pathophysiology",
    "diagnosis",
    "control",
    "references"
  ],
  "additionalProperties": false,
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Kebab-case identifier. Must equal the filename without .json."
    },
    "name": { "type": "string", "minLength": 2 },
    "synonyms": {
      "type": "array",
      "items": { "type": "string", "minLength": 2 },
      "description": "Other names in clinical or lay use. The validator rejects a synonym that collides with another record's name."
    },
    "category": {
      "enum": ["infectious", "parasitic", "toxic", "metabolic", "nutritional", "genetic", "immune-mediated", "degenerative"],
      "description": "The dominant mechanism. 'infectious' and 'parasitic' require at least one biological agent."
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind", "name"],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": ["bacterium", "virus", "fungus", "protozoan", "helminth", "arthropod", "prion", "toxin", "mycotoxin", "mineral", "management", "genetic", "immune"]
          },
          "name": { "type": "string", "minLength": 2 },
          "notes": { "type": "string" },
          "toxins": { "type": "array", "items": { "type": "string" } },
          "vector": { "type": "string", "description": "Arthropod vector, if vector-borne." },
          "reservoir": { "type": "string", "description": "Maintenance host or environmental reservoir." }
        }
      }
    },
    "hosts": {
      "type": "object",
      "required": ["primary"],
      "additionalProperties": false,
      "properties": {
        "primary": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "also": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string", "description": "Age, sex, breed or production-stage predilections." }
      }
    },
    "zoonotic": { "type": "boolean" },
    "notifiable": {
      "type": "object",
      "required": ["woah"],
      "additionalProperties": false,
      "properties": {
        "woah": { "type": "boolean", "description": "WOAH (formerly OIE) listed disease." },
        "national": { "type": "boolean", "description": "Notifiable in the primary jurisdiction this record targets." },
        "note": { "type": "string" }
      }
    },
    "distribution": { "type": "string" },
    "aetiology": {
      "type": "object",
      "required": ["summary", "determinants", "risk_factors"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 40 },
        "determinants": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "What must be true for disease to occur — the causal web, not just the agent." },
        "risk_factors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "epidemiology": { "type": "string", "description": "Morbidity, mortality, transmission routes, seasonality, maintenance strategy." }
      }
    },
    "pathophysiology": {
      "type": "object",
      "required": ["summary", "cascade", "lesions", "clinical_signs"],
      "additionalProperties": false,
      "properties": {
        "summary": { "type": "string", "minLength": 40 },
        "cascade": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["title", "detail"],
            "additionalProperties": false,
            "properties": {
              "title": { "type": "string", "minLength": 3 },
              "detail": { "type": "string", "minLength": 20 }
            }
          },
          "description": "Ordered sequence from exposure to the lesion that explains the clinical signs."
        },
        "lesions": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Gross and microscopic findings." },
        "clinical_signs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "diagnosis": {
      "type": "object",
      "required": ["laboratory", "differentials"],
      "additionalProperties": false,
      "properties": {
        "antemortem": { "type": "array", "items": { "type": "string" } },
        "postmortem": { "type": "array", "items": { "type": "string" } },
        "laboratory": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "differentials": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "control": {
      "type": "object",
      "required": ["prevention", "treatment"],
      "additionalProperties": false,
      "properties": {
        "prevention": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "vaccination": { "type": "string" },
        "treatment": { "type": "array", "items": { "type": "string" }, "description": "Empty array means no practical treatment; say why in 'notes'." },
        "outbreak": { "type": "array", "items": { "type": "string" }, "description": "Immediate actions on suspicion or confirmation." },
        "public_health": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "prognosis": { "type": "string" },
    "related": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Slugs of related records. Referential integrity is enforced."
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label", "url"],
        "additionalProperties": false,
        "properties": {
          "label": { "type": "string", "minLength": 3 },
          "url": { "type": "string", "pattern": "^https?://" }
        }
      }
    }
  }
}
